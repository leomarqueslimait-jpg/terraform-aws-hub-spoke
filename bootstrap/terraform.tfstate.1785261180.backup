    {
      "mode": "data",
      "type": "aws_iam_policy_document",
      "name": "hub_only",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "1170364112",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadSpokeStateForRemoteState\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetObject\",\n      \"Resource\": [\n        \"arn:aws:s3:::hub-spoke-tf-state-new/spoke-prod/terraform.tfstate\",\n        \"arn:aws:s3:::hub-spoke-tf-state-new/spoke-dev/terraform.tfstate\"\n      ]\n    },\n    {\n      \"Sid\": \"TransitGateway\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:ReplaceTransitGatewayRoute\",\n        \"ec2:ModifyTransitGatewayVpcAttachment\",\n        \"ec2:ModifyTransitGateway\",\n        \"ec2:EnableTransitGatewayRouteTablePropagation\",\n        \"ec2:DisassociateTransitGatewayRouteTable\",\n        \"ec2:DisableTransitGatewayRouteTablePropagation\",\n        \"ec2:DeleteTransitGatewayVpcAttachment\",\n        \"ec2:DeleteTransitGatewayRouteTable\",\n        \"ec2:DeleteTransitGatewayRoute\",\n        \"ec2:DeleteTransitGateway\",\n        \"ec2:CreateTransitGatewayVpcAttachment\",\n        \"ec2:CreateTransitGatewayRouteTable\",\n        \"ec2:CreateTransitGatewayRoute\",\n        \"ec2:CreateTransitGateway\",\n        \"ec2:AssociateTransitGatewayRouteTable\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"Route53PrivateZone\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"route53:ListTagsForResource\",\n        \"route53:ListResourceRecordSets\",\n        \"route53:ListHostedZones\",\n        \"route53:GetHostedZone\",\n        \"route53:DisassociateVPCFromHostedZone\",\n        \"route53:DeleteHostedZone\",\n        \"route53:CreateHostedZone\",\n        \"route53:ChangeTagsForResource\",\n        \"route53:ChangeResourceRecordSets\",\n        \"route53:AssociateVPCWithHostedZone\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"FlowLogsCloudWatch\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"logs:TagResource\",\n        \"logs:PutRetentionPolicy\",\n        \"logs:DescribeLogStreams\",\n        \"logs:DescribeLogGroups\",\n        \"logs:DeleteLogGroup\",\n        \"logs:CreateLogGroup\",\n        \"ec2:DeleteFlowLogs\",\n        \"ec2:CreateFlowLogs\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"FlowLogsDeliveryRole\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:TagRole\",\n        \"iam:PutRolePolicy\",\n        \"iam:PassRole\",\n        \"iam:ListRolePolicies\",\n        \"iam:GetRolePolicy\",\n        \"iam:GetRole\",\n        \"iam:DeleteRolePolicy\",\n        \"iam:DeleteRole\",\n        \"iam:CreateRole\"\n      ],\n      \"Resource\": \"arn:aws:iam::300272448172:role/vpc-flow-logs-role\"\n    }\n  ]\n}",
